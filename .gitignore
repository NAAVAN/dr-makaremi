# Dependencies
node_modules/
.pnpm-store/

# Next.js & Vercel build
.next/
.vercel/
out/

# Environment & Secret files (recursive)
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key

# Cloudflare Tunnel credentials (keep template only)
infra/cloudflared/*.json
infra/cloudflared/cert.pem
!infra/cloudflared/config.yml.template

# Turbo
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db

# Database / Local volumes
infra/postgres/pgdata/

# Standalone Skills Studio & Reference Lab (decoupled from deliverable website)
studio-lab/

# Raw WordPress export dumps
*.WordPress.*.xml
*.sql

# Graphify local knowledge graph outputs (auto-rebuilt by git hooks)
graphify-out/

# Runtime studio security PIN/key hash overrides (never commit live credential hashes)
packages/shared/src/data/curator-overlays/studio-security-overrides.json
